{
  "name": "prof-joe-ai",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "server": "node local-server.js",
    "dev": "node -e \"require('child_process').spawn('node', ['local-server.js'], {stdio:'inherit'}); require('child_process').spawn('npx', ['vite'], {stdio:'inherit', shell:true});\"",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build",
    "build:student": "tsc -b && vite build",
    "cap:build": "vite build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "verify": "tsc -b && oxlint",
    "verify:full": "tsc -b && oxlint && vite build && gitnexus analyze",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@tldraw/tldraw": "^5.3.1",
    "@types/jspdf": "^1.3.3",
    "@types/katex": "^0.16.8",
    "@types/pako": "^2.0.4",
    "@xyflow/react": "^12.11.3",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "mongodb": "^7.5.0",
    "motion": "^12.42.2",
    "pako": "^3.0.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
